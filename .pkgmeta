# Empaquetado con BigWigsMods/packager. Un TOC con Interface 16xxx se publica como flavor Forever.
package-as: GuardaMateriales

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - .luacheckrc
  - .luarc.json
  - stylua.toml
  - .github
  - tests
  - tools
  - .busted
  - docs
